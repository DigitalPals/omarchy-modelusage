# Install as /etc/cpa-usage-keeper/keeper.env, root-owned mode 0600.
# Use the proxy's internal address with valid TLS, bypassing admission gates
# which wait for long-lived connections to close before updating the proxy.
CPA_BASE_URL=https://cli-proxy.home.arpa:8318
CPA_MANAGEMENT_KEY=replace-with-management-key
REDIS_QUEUE_ADDR=cli-proxy.home.arpa:8318
REDIS_QUEUE_TLS=true
TLS_SKIP_VERIFY=false
APP_HOST=127.0.0.1
APP_PORT=8320
APP_BASE_PATH=/keeper
CPA_PUBLIC_URL=https://proxy.example.com
AUTH_ENABLED=true
LOGIN_PASSWORD=replace-with-a-separate-keeper-password
TZ=Europe/Amsterdam
SQLITE_PATH=/var/lib/cpa-usage-keeper/data/app.db
BACKUP_ENABLED=true
