#!/usr/bin/env bash
# Prepares The Beast's Arch container for tests/ci-qml (fast-test's beast.prepare):
# the same pinned Arch snapshot, Quickshell/Qt and Omarchy shell as the QML CI job.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
snapshot=$(sed -n 's/.*ARCH_SNAPSHOT: "\(.*\)"/\1/p' .github/workflows/ci.yml)
commit=$(sed -n 's/.*OMARCHY_COMMIT: //p' .github/workflows/ci.yml)
echo "Server = https://archive.archlinux.org/repos/${snapshot}/\$repo/os/\$arch" > /etc/pacman.d/mirrorlist
pacman -Syyuu --noconfirm --needed git quickshell qt6-declarative qt6-svg qt6-wayland \
  python python-websockets nodejs ripgrep jq sway ttf-jetbrains-mono-nerd >/dev/null
git init -q /opt/omarchy
git -C /opt/omarchy fetch -q --depth 1 https://github.com/basecamp/omarchy.git "$commit"
git -C /opt/omarchy checkout -q FETCH_HEAD
